{
  "name": "clausewise",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/copy-pdf-worker.mjs && next build --webpack",
    "build:appsail": "node scripts/package-appsail.mjs",
    "start": "node scripts/start.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "password:hash": "node scripts/hash-password.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate:local": "node --env-file=.env.local scripts/migrate-local.mjs",
    "local:dev": "npm run db:up && npm run db:migrate:local && npm run dev -- --host 127.0.0.1",
    "test": "node --experimental-strip-types tests/engine.test.ts && node --experimental-strip-types tests/auth.test.ts && node --experimental-strip-types tests/storage.test.ts && node --experimental-strip-types tests/connections.test.ts && node --experimental-strip-types tests/workflow.test.ts && node --experimental-strip-types tests/local-setup.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.13.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
